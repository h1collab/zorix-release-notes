<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Compare models | Zorix Code</title>

<style>
:root{
  --bg:#fff;
  --text:#0d0d0d;
  --muted:#6b6b67;
  --line:#deded9;
  --soft:#f7f7f5;
  --max:1180px;
}

*{box-sizing:border-box}

html{
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);

  font-family:
    "OpenAI Sans",
    "Inter",
    ui-sans-serif,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Helvetica,
    Arial,
    sans-serif;

  letter-spacing:-.012em;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
select{
  font:inherit;
  color:inherit;
}

header{
  position:sticky;
  top:0;
  z-index:20;

  background:rgba(255,255,255,.94);
  backdrop-filter:blur(15px);

  border-bottom:1px solid var(--line);
}

.nav{
  max-width:var(--max);
  height:64px;

  margin:auto;
  padding:0 24px;

  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  font-size:20px;
  font-weight:600;
  letter-spacing:-.045em;
}

.nav-right{
  display:flex;
  gap:24px;
  font-size:14px;
}

main{
  max-width:var(--max);

  margin:auto;
  padding:65px 24px 120px;
}

.back{
  display:inline-flex;
  margin-bottom:54px;

  color:var(--muted);
  font-size:14px;
}

.eyebrow{
  color:var(--muted);
  font-size:14px;
  margin-bottom:17px;
}

h1{
  margin:0;

  font-size:clamp(60px,9vw,112px);
  font-weight:500;

  line-height:.9;
  letter-spacing:-.067em;
}

.intro{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(280px,420px);
  gap:50px;

  align-items:end;

  padding-bottom:55px;
  border-bottom:1px solid var(--line);
}

.intro p{
  margin:0;

  color:var(--muted);
  font-size:15px;
  line-height:1.55;
}

.selectors{
  display:grid;
  grid-template-columns:1fr 55px 1fr;

  gap:15px;
  align-items:center;

  padding:35px 0;
  border-bottom:1px solid var(--line);
}

.selector{
  width:100%;

  border:1px solid var(--line);
  background:#fff;

  border-radius:10px;
  padding:13px 14px;

  outline:none;
}

.vs{
  text-align:center;
  color:var(--muted);
  font-size:13px;
}

.model-heads{
  display:grid;
  grid-template-columns:1fr 1fr;

  border-bottom:1px solid var(--line);
}

.model-head{
  padding:34px 0 38px;
}

.model-head:first-child{
  padding-right:34px;
  border-right:1px solid var(--line);
}

.model-head:last-child{
  padding-left:34px;
}

.identity{
  display:flex;
  gap:16px;
  align-items:flex-start;
}

.logo{
  width:45px;
  height:45px;

  display:grid;
  place-items:center;

  flex:0 0 auto;
}

.logo img{
  max-width:40px;
  max-height:40px;
  object-fit:contain;
}

.logo-fallback{
  width:38px;
  height:38px;

  border:1px solid var(--line);
  border-radius:50%;

  display:grid;
  place-items:center;
}

.provider{
  color:var(--muted);
  font-size:13px;
  margin-bottom:7px;
}

.model-title{
  font-size:28px;
  line-height:1.05;

  letter-spacing:-.045em;
}

.model-status{
  display:flex;
  flex-wrap:wrap;
  gap:6px;

  margin-top:14px;
}

.tag{
  border:1px solid var(--line);
  border-radius:999px;

  padding:5px 8px;

  font-size:11px;
}

.section{
  padding:54px 0;
  border-bottom:1px solid var(--line);
}

.section-head{
  display:flex;
  justify-content:space-between;
  gap:24px;

  margin-bottom:26px;
}

.section-title{
  font-size:29px;
  letter-spacing:-.04em;
}

.section-note{
  max-width:450px;

  color:var(--muted);
  font-size:13px;
  line-height:1.5;
}

.compare-table{
  width:100%;
  border-collapse:collapse;
}

.compare-table th,
.compare-table td{
  padding:17px 12px;

  border-top:1px solid var(--line);
}

.compare-table th{
  width:27%;

  color:var(--muted);
  font-size:12px;
  font-weight:500;

  text-align:left;
}

.compare-table td{
  width:36.5%;
  font-size:15px;
}

.compare-table td:last-child,
.compare-table th:last-child{
  border-left:1px solid var(--line);
}

.value-main{
  font-size:18px;
  letter-spacing:-.025em;
}

.value-sub{
  margin-top:4px;

  color:var(--muted);
  font-size:11px;
}

.winner{
  display:inline-block;

  margin-left:6px;
  padding:3px 6px;

  border-radius:999px;
  background:#111;
  color:#fff;

  font-size:9px;
  vertical-align:2px;
}

.benchmark-grid{
  display:grid;
  grid-template-columns:1fr 1fr;

  gap:42px;
}

.benchmark-card{
  padding-top:18px;
  border-top:1px solid var(--line);
}

.benchmark-name{
  font-size:15px;
  margin-bottom:25px;
}

.benchmark-pair{
  display:grid;
  grid-template-columns:1fr 1fr;

  gap:18px;
}

.benchmark-score{
  font-size:48px;
  letter-spacing:-.055em;
}

.benchmark-model{
  margin-top:7px;

  color:var(--muted);
  font-size:12px;
}

.delta{
  margin-top:23px;
  padding-top:14px;

  border-top:1px solid var(--line);

  color:var(--muted);
  font-size:12px;
}

.usage-hero{
  display:grid;
  grid-template-columns:1fr 1fr;

  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}

.usage-number{
  padding:25px 0 29px;
}

.usage-number:first-child{
  padding-right:30px;
  border-right:1px solid var(--line);
}

.usage-number:last-child{
  padding-left:30px;
}

.usage-label{
  color:var(--muted);
  font-size:12px;
}

.usage-value{
  margin-top:18px;

  font-size:43px;
  letter-spacing:-.055em;
}

.usage-secondary{
  margin-top:7px;

  color:var(--muted);
  font-size:12px;
}

.chart-wrap{
  margin-top:38px;
}

.chart{
  height:310px;

  position:relative;

  border-left:1px solid var(--line);
  border-bottom:1px solid var(--line);
}

.grid-line{
  position:absolute;
  left:0;
  right:0;

  border-top:1px solid #ededeb;
}

.line-svg{
  position:absolute;
  inset:0;

  width:100%;
  height:100%;

  overflow:visible;
}

.legend{
  display:flex;
  gap:24px;
  flex-wrap:wrap;

  margin-top:17px;
}

.legend-item{
  display:flex;
  align-items:center;
  gap:8px;

  color:var(--muted);
  font-size:12px;
}

.legend-line{
  width:22px;
  height:3px;
  border-radius:99px;
}

.summary-box{
  margin-top:30px;

  display:grid;
  grid-template-columns:repeat(3,1fr);

  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}

.summary-item{
  padding:22px 0;
}

.summary-item:not(:first-child){
  padding-left:24px;
  border-left:1px solid var(--line);
}

.summary-k{
  color:var(--muted);
  font-size:11px;
}

.summary-v{
  margin-top:10px;

  font-size:20px;
  letter-spacing:-.03em;
}

.empty{
  color:var(--muted);
}

@media(max-width:760px){

  main{
    padding:40px 18px 90px;
  }

  .intro{
    grid-template-columns:1fr;
    gap:25px;
  }

  .selectors{
    grid-template-columns:1fr;
  }

  .vs{
    text-align:left;
  }

  .model-heads{
    grid-template-columns:1fr;
  }

  .model-head:first-child{
    border-right:0;
    border-bottom:1px solid var(--line);
    padding-right:0;
  }

  .model-head:last-child{
    padding-left:0;
  }

  .benchmark-grid{
    grid-template-columns:1fr;
  }

  .usage-hero{
    grid-template-columns:1fr;
  }

  .usage-number:first-child{
    border-right:0;
    border-bottom:1px solid var(--line);
    padding-right:0;
  }

  .usage-number:last-child{
    padding-left:0;
  }

  .summary-box{
    grid-template-columns:1fr;
  }

  .summary-item:not(:first-child){
    border-left:0;
    border-top:1px solid var(--line);
    padding-left:0;
  }

  .compare-table{
    font-size:12px;
  }

  .compare-table th,
  .compare-table td{
    padding:13px 6px;
  }
}
</style>
</head>

<body>

<header>
  <nav class="nav">

    <a class="brand" href="../">
      zorix
    </a>

    <div class="nav-right">
      <a href="./">Usage</a>
