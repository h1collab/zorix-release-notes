<script src="./models.js?v=1788109833"></script>
<script src="./usage.js?v=1788109833"></script>

<script>

/*
 * Benchmark values currently used by the Zorix benchmark page.
 * Entries without a published/evaluated score remain absent.
 */

const benchmarkScores = {

  "nex-coder-38-neptune":{
    terminal:99.0,
    swe:99.0
  },

  "nex-coder-38-uranus":{
    terminal:98.8,
    swe:98.8
  },

  "nex-coder-38-mercury":{
    terminal:98.4,
    swe:98.4
  },

  "nex-coder-37-pro":{
    terminal:97.4,
    swe:97.4
  },

  "claude-opus-5":{
    terminal:91.6,
    swe:92.4
  },

  "gpt-56-luna":{
    terminal:90.6,
    swe:91.4
  },

  "gemini-37-flash":{
    terminal:89.2,
    swe:90.0
  },

  "deepseek-v4-flash-0731":{
    terminal:87.7,
    swe:88.5
  }

};


/*
 * Benchmark-only models. These exist in evaluation comparison
 * even when they are not usage entries in models.js.
 */

const benchmarkOnly = [

  {
    id:"nex-coder-38-uranus",
    name:"Nex Coder 3.8 Uranus",
    provider:"Zorix",
    family:"Nex Coder 3.8",
    status:"AA4 Preview",
    logo:"./assets/logos/zorix.svg",
    context:"2M tokens",
    parameters:"Undisclosed",
    activeParameters:"Undisclosed",
    architecture:"Closed / AA4",
    dailyTokens:null,
    weeklyTokens:null,
    chart:[],
    color:"#5B5BD6"
  },

  {
    id:"nex-coder-38-mercury",
    name:"Nex Coder 3.8 Mercury",
    provider:"Zorix",
    family:"Nex Coder 3.8",
    status:"AA4 Preview",
    logo:"./assets/logos/zorix.svg",
    context:"2M tokens",
    parameters:"Undisclosed",
    activeParameters:"Undisclosed",
    architecture:"Closed / AA4",
    dailyTokens:null,
    weeklyTokens:null,
    chart:[],
    color:"#327FEA"
  },

  {
    id:"nex-coder-37-pro",
    name:"Nex Coder 3.7 Pro",
    provider:"Zorix",
    family:"Nex Coder",
    status:"Evaluation",
    logo:"./assets/logos/zorix.svg",
    context:"—",
    parameters:"Undisclosed",
    activeParameters:"Undisclosed",
    architecture:"Closed",
    dailyTokens:null,
    weeklyTokens:null,
    chart:[],
    color:"#666"
  }

];


const sourceModels = window.ZORIX_MODEL_DETAILS || [];

const models = [
  ...sourceModels,
  ...benchmarkOnly.filter(
    b => !sourceModels.some(m => m.id === b.id)
  )
];


const usageData =
  window.ZORIX_CODE_USAGE?.models || [];


function fmt(n){

  if(n === null ||
     n === undefined ||
     !Number.isFinite(Number(n))){
    return "—";
  }

  n = Number(n);

  if(n >= 1e15)
    return (n/1e15).toFixed(2)
      .replace(/\.00$/,"") + "P";

  if(n >= 1e12)
    return (n/1e12).toFixed(2)
      .replace(/\.00$/,"") + "T";

  if(n >= 1e9)
    return (n/1e9).toFixed(2)
      .replace(/\.00$/,"") + "B";

  if(n >= 1e6)
    return (n/1e6).toFixed(2)
      .replace(/\.00$/,"") + "M";

  if(n >= 1e3)
    return (n/1e3).toFixed(2)
      .replace(/\.00$/,"") + "K";

  return String(Math.round(n));
}


function getWeekly(model){

  if(model.weeklyTokens != null)
    return Number(model.weeklyTokens);

  if(model.dailyTokens != null)
    return Number(model.dailyTokens) * 7;

  return null;
}


function getUsageShare(model){

  const item = usageData.find(
    x => x.name === model.name
  );

  return item?.share ?? null;
}


function modelLogo(m){

  if(m.logo){
    return `
      <div class="logo">
        <img src="${m.logo}" alt="">
      </div>
    `;
  }

  return `
    <div class="logo">
      <span class="logo-fallback">
        ${m.provider?.slice(0,1) || "?"}
      </span>
    </div>
  `;
}


function headHTML(m){

  return `
    <div class="identity">

      ${modelLogo(m)}

      <div>

        <div class="provider">
          ${m.provider || "—"}
        </div>

        <div class="model-title">
          ${m.name}
        </div>

        <div class="model-status">
          <span class="tag">
            ${m.family || "—"}
          </span>

          <span class="tag">
            ${m.status || "—"}
          </span>
        </div>

      </div>

    </div>
  `;
}


function numericWinner(a,b,higher=true){

  if(!Number.isFinite(Number(a)) ||
     !Number.isFinite(Number(b))){
    return [false,false];
  }

  a=Number(a);
  b=Number(b);

  if(a===b)
    return [false,false];

  if(higher)
    return [a>b,b>a];

  return [a<b,b<a];
}


function cell(value,win=false,sub=""){

  return `
    <div class="value-main">
      ${value}
      ${win ? '<span class="winner">higher</span>' : ''}
    </div>

    ${sub
      ? `<div class="value-sub">${sub}</div>`
      : ''
    }
  `;
}


function row(label,a,b){

  return `
    <tr>
      <th>${label}</th>
      <td>${a}</td>
      <td>${b}</td>
    </tr>
  `;
}


function renderSpecs(a,b){

  const dailyWin =
    numericWinner(
      a.dailyTokens,
      b.dailyTokens
    );

  const weeklyA = getWeekly(a);
  const weeklyB = getWeekly(b);

  const weeklyWin =
    numericWinner(
      weeklyA,
      weeklyB
    );

  const shareA = getUsageShare(a);
  const shareB = getUsageShare(b);

  const shareWin =
    numericWinner(
      shareA,
      shareB
    );

  const rows = [

    row(
      "Provider",
      cell(a.provider || "—"),
      cell(b.provider || "—")
    ),

    row(
      "Family",
      cell(a.family || "—"),
      cell(b.family || "—")
    ),

    row(
      "Status",
      cell(a.status || "—"),
      cell(b.status || "—")
    ),

    row(
      "Daily tokens",
      cell(
        a.dailyTokens != null
          ? fmt(a.dailyTokens)
          : "—",
        dailyWin[0]
      ),
      cell(
        b.dailyTokens != null
          ? fmt(b.dailyTokens)
          : "—",
        dailyWin[1]
      )
    ),

    row(
      "Weekly tokens",
      cell(
        weeklyA != null
          ? fmt(weeklyA)
          : "—",
        weeklyWin[0]
      ),
      cell(
        weeklyB != null
          ? fmt(weeklyB)
          : "—",
        weeklyWin[1]
      )
    ),

    row(
      "Usage share",
      cell(
        shareA != null
          ? shareA.toFixed(4) + "%"
          : "—",
        shareWin[0]
      ),
      cell(
        shareB != null
          ? shareB.toFixed(4) + "%"
          : "—",
        shareWin[1]
      )
    ),

    row(
      "Context",
      cell(a.context || "—"),
      cell(b.context || "—")
    ),

    row(
      "Parameters",
      cell(a.parameters || "—"),
      cell(b.parameters || "—")
    ),

    row(
      "Active parameters",
      cell(a.activeParameters || "—"),
      cell(b.activeParameters || "—")
    ),

    row(
      "Architecture",
      cell(a.architecture || "—"),
      cell(b.architecture || "—")
    ),

    row(
      "Input",
      cell(a.inputPrice || "—"),
      cell(b.inputPrice || "—")
    ),

    row(
      "Output",
      cell(a.outputPrice || "—"),
      cell(b.outputPrice || "—")
    ),

    row(
      "Source",
      cell(a.source || "Zorix Code"),
      cell(b.source || "Zorix Code")
    )

  ];

  document.getElementById("specRows")
    .innerHTML = rows.join("");
}


function benchmarkValue(model,key){

  const score = benchmarkScores[model.id];

  if(!score)
    return null;

  return score[key] ?? null;
}


function benchmarkDelta(a,b,key,target){

  const av = benchmarkValue(a,key);
  const bv = benchmarkValue(b,key);

  if(av == null || bv == null){

    document.getElementById(target)
      .textContent =
      "No comparable score is available for both models.";

    return;
  }

  const diff = Math.abs(av-bv);

  let winner = "Tie";

  if(av > bv)
    winner = a.name;

  if(bv > av)
    winner = b.name;

  document.getElementById(target)
    .textContent =
    winner === "Tie"
      ? "Both models have the same recorded score."
      : `${winner} leads by ${diff.toFixed(1)} percentage points.`;
}


function renderBenchmarks(a,b){

  const ta=benchmarkValue(a,"terminal");
  const tb=benchmarkValue(b,"terminal");

  const sa=benchmarkValue(a,"swe");
  const sb=benchmarkValue(b,"swe");

  document.getElementById("terminalA")
    .textContent =
      ta == null ? "—" : ta.toFixed(1)+"%";

  document.getElementById("terminalB")
    .textContent =
      tb == null ? "—" : tb.toFixed(1)+"%";

  document.getElementById("sweA")
    .textContent =
      sa == null ? "—" : sa.toFixed(1)+"%";

  document.getElementById("sweB")
    .textContent =
      sb == null ? "—" : sb.toFixed(1)+"%";

  document.getElementById("terminalNameA")
    .textContent=a.name;

  document.getElementById("terminalNameB")
    .textContent=b.name;

  document.getElementById("sweNameA")
    .textContent=a.name;

  document.getElementById("sweNameB")
    .textContent=b.name;

  benchmarkDelta(
    a,b,
    "terminal",
    "terminalDelta"
  );

  benchmarkDelta(
    a,b,
    "swe",
    "sweDelta"
  );
}


function scaledChart(m){

  const arr = m.chart || [];

  if(!arr.length ||
     m.dailyTokens == null)
    return [];

  const last =
    Number(arr[arr.length-1]) || 1;

  return arr.map(
    x => Number(x)/last *
         Number(m.dailyTokens)
  );
}


function linePoints(values,max){

  if(!values.length)
    return "";

  return values.map((v,i)=>{

    const x =
      values.length===1
        ? 0
        : i/(values.length-1)*1000;

    const y =
      300 -
      (v/max)*270 -
      15;

    return `${x.toFixed(1)},${y.toFixed(1)}`;

  }).join(" ");
}


function renderUsage(a,b){

  const weeklyA=getWeekly(a);
  const weeklyB=getWeekly(b);

  document.getElementById("usageNameA")
    .textContent=a.name;

  document.getElementById("usageNameB")
    .textContent=b.name;

  document.getElementById("usageA")
    .textContent=
      a.dailyTokens != null
        ? fmt(a.dailyTokens)+" / day"
        : "—";

  document.getElementById("usageB")
    .textContent=
      b.dailyTokens != null
        ? fmt(b.dailyTokens)+" / day"
        : "—";

  document.getElementById("weeklyA")
    .textContent=
      weeklyA != null
        ? fmt(weeklyA)+" / week"
        : "No usage volume available";

  document.getElementById("weeklyB")
    .textContent=
      weeklyB != null
        ? fmt(weeklyB)+" / week"
        : "No usage volume available";


  const aa=scaledChart(a);
  const bb=scaledChart(b);

  const all=[...aa,...bb];

  const max=Math.max(...all,1);

  const svg=
    document.getElementById("usageChart");

  svg.innerHTML="";


  if(aa.length){

    svg.insertAdjacentHTML(
      "beforeend",
      `
      <polyline
        points="${linePoints(aa,max)}"
        fill="none"
        stroke="${a.color || "#111"}"
        stroke-width="4"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
        stroke-linejoin="round">
      </polyline>
      `
    );

  }


  if(bb.length){

    svg.insertAdjacentHTML(
      "beforeend",
      `
      <polyline
        points="${linePoints(bb,max)}"
        fill="none"
        stroke="${b.color || "#777"}"
        stroke-width="4"
        vector-effect="non-scaling-stroke"
        stroke-linecap="round"
        stroke-linejoin="round">
      </polyline>
      `
    );

  }


  document.getElementById("usageLegend")
    .innerHTML=`

      <div class="legend-item">
        <span
          class="legend-line"
          style="background:${a.color || "#111"}">
        </span>
        ${a.name}
      </div>

      <div class="legend-item">
        <span
          class="legend-line"
          style="background:${b.color || "#777"}">
        </span>
        ${b.name}
      </div>
    `;


  const da=Number(a.dailyTokens);
  const db=Number(b.dailyTokens);


  if(Number.isFinite(da) &&
     Number.isFinite(db)){

    document.getElementById("combinedUsage")
      .textContent=
        fmt(da+db);


    if(da===db){

      document.getElementById("higherUsage")
        .textContent="Tie";

      document.getElementById("usageRatio")
        .textContent="1×";

    }else{

      const winner =
        da>db ? a : b;

      const hi=Math.max(da,db);
      const lo=Math.min(da,db);

      document.getElementById("higherUsage")
        .textContent=winner.name;

      document.getElementById("usageRatio")
        .textContent=
          lo>0
            ? (hi/lo).toFixed(
                hi/lo > 100 ? 0 : 2
              )+"×"
            : "—";

    }

  }else{

    document.getElementById("higherUsage")
      .textContent="—";

    document.getElementById("usageRatio")
      .textContent="—";

    document.getElementById("combinedUsage")
      .textContent="—";

  }

}


function render(){

  const a=models.find(
    x => x.id ===
    document.getElementById("modelA").value
  );

  const b=models.find(
    x => x.id ===
    document.getElementById("modelB").value
  );

  if(!a || !b)
    return;


  document.getElementById("headA")
    .innerHTML=headHTML(a);

  document.getElementById("headB")
    .innerHTML=headHTML(b);


  renderSpecs(a,b);
  renderUsage(a,b);
  renderBenchmarks(a,b);


  const url =
    new URL(location.href);

  url.searchParams.set("a",a.id);
  url.searchParams.set("b",b.id);

  history.replaceState(
    null,
    "",
    url
  );

}


const selectA =
  document.getElementById("modelA");

const selectB =
  document.getElementById("modelB");


const sorted=[
  ...models
].sort(
  (a,b)=>
    (b.dailyTokens || 0) -
    (a.dailyTokens || 0)
);


function optionHTML(m){

  return `
    <option value="${m.id}">
      ${m.name} — ${m.provider}
    </option>
  `;
}


selectA.innerHTML=
  sorted.map(optionHTML).join("");

selectB.innerHTML=
  sorted.map(optionHTML).join("");


const params=
  new URLSearchParams(location.search);

const requestedA=params.get("a");
const requestedB=params.get("b");


selectA.value =
  models.some(x=>x.id===requestedA)
    ? requestedA
    : "nex-coder-38-neptune";


let defaultB =
  models.some(x=>x.id===requestedB)
    ? requestedB
    : "claude-opus-5";


if(defaultB===selectA.value){

  defaultB =
    sorted.find(
      x=>x.id!==selectA.value
    )?.id || "";

}

selectB.value=defaultB;


selectA.addEventListener(
  "change",
  render
);

selectB.addEventListener(
  "change",
  render
);

render();

</script>

