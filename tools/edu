#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/projects/zorix-release-notes"

if [ "$1" != "plus" ]; then
  echo "Usage: edu plus"
  exit 1
fi

cd "$ROOT" || exit 1

echo
echo "ZORIX CODE / OFFICIAL QUOTA"
echo

printf "Amount (examples: 500M, 10B, 1.5T): "
read -r amount

[ -n "$amount" ] || {
  echo "Amount is required."
  exit 1
}

printf "Note [Official allocation]: "
read -r note

note="${note:-Official allocation}"

python tools/quota_update.py official "$amount" "$note" || exit 1

git add \
  data/public-quota.json \
  number-of-calls/quota.js

if git diff --cached --quiet; then
  echo "Nothing changed."
  exit 0
fi

git commit -m "Issue Zorix Code public quota"
git push

echo
echo "Public quota published."
