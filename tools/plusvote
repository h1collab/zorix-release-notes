#!/usr/bin/env python3

from pathlib import Path
from datetime import datetime
import subprocess
import json
import sys

ROOT = Path.home() / "projects/zorix-release-notes"

DATA = ROOT / "data/votes.json"
BUILD = ROOT / "tools/build_votes.py"


def usage():
    print(
        "Usage:\n"
        "  plusvote <model-id> <votes> [uncertainty]\n\n"
        "Examples:\n"
        "  plusvote nex-coder-38-neptune 1600 4\n"
        "  plusvote claude-opus-5 1540 5"
    )


if len(sys.argv) < 3:
    usage()
    raise SystemExit(1)


model_id = sys.argv[1]


try:
    votes = int(
        sys.argv[2]
        .replace(",", "")
    )
except ValueError:
    raise SystemExit("votes must be an integer")


uncertainty = 0

if len(sys.argv) >= 4:
    try:
        uncertainty = int(
            sys.argv[3]
            .replace("±", "")
            .replace(",", "")
        )
    except ValueError:
        raise SystemExit(
            "uncertainty must be an integer"
        )


data = json.loads(
    DATA.read_text(
        encoding="utf-8"
    )
)

models = data.setdefault(
    "models",
    []
)

history = data.setdefault(
    "history",
    []
)


target = next(
    (
        x
        for x in models
        if x.get("id") == model_id
    ),
    None
)


if target is None:
    target = {
        "id": model_id,
        "votes": 0,
        "uncertainty": 0
    }

    models.append(target)


target["votes"] = votes
target["uncertainty"] = uncertainty


# Full leaderboard snapshot.
snapshot = {
    "at": datetime.now()
        .astimezone()
        .isoformat(timespec="seconds"),

    "models": {
        item["id"]: {
            "votes": int(
                item.get("votes", 0)
            ),
            "uncertainty": int(
                item.get(
                    "uncertainty",
                    0
                )
            )
        }
        for item in models
        if item.get("id")
    }
}


history.append(snapshot)


# Avoid unlimited file growth.
# Keep latest 365 snapshots for now.
if len(history) > 365:
    data["history"] = history[-365:]


DATA.write_text(
    json.dumps(
        data,
        ensure_ascii=False,
        indent=2
    ),
    encoding="utf-8"
)


subprocess.run(
    [
        sys.executable,
        str(BUILD)
    ],
    check=True
)


print(
    f"{model_id}: "
    f"{votes:,} votes"
    +
    (
        f" ±{uncertainty}"
        if uncertainty
        else ""
    )
)

print(
    "Voting history snapshot added."
)
